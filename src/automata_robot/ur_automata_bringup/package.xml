<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_automata_bringup</name>
  <version>0.0.1</version>
  <description>Bring-up package for the ur_automata cell (URSim and real UR5e).</description>
  <maintainer email="do.park@iit.it">Do Won Park</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ur_automata_description</exec_depend>
  <exec_depend>ur_automata_moveit_config</exec_depend>
  <exec_depend>ur_automata_scene</exec_depend>
  <exec_depend>ur_automata_scan</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>ur_controllers</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
