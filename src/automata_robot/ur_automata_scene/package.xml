<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_automata_scene</name>
  <version>0.0.1</version>
  <description>Pubblica la planning scene (tavolo, supporti, sfera marker) per la cella ur_automata.</description>
  <maintainer email="do.park@iit.it">Do Won Park</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>eigen</depend>

  <exec_depend>ur_automata_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
