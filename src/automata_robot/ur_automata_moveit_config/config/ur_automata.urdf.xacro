<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur_automata">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import ur_automata urdf file -->
    <xacro:include filename="$(find ur_automata_description)/urdf/ur_automata.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="ur_automata.ros2_control.xacro" />


    <xacro:ur_automata_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
